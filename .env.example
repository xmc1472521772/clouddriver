# ===========================================
# 个人云网盘 环境变量配置
# ===========================================

# 服务端口
PORT=3000

# 登录密码（请修改为你自己的密码）
AUTH_PASSWORD=xmc000000

# JWT 密钥（请修改为随机字符串）
JWT_SECRET=C3xuPygByKM9dudZhFrPkE0OlinB1eYN

# ===========================================
# Google Drive API 配置（OAuth2 用户授权）
#
# 使用你自己的 Google 账号的 15GB 存储空间
# 无需信用卡，无需 Service Account
#
# 获取步骤:
# 1. Google Cloud Console → APIs & Services → Credentials
# 2. Create Credentials → OAuth client ID
# 3. Application type: Web application
# 4. Authorized redirect URIs: http://localhost:3001/oauth2callback
# 5. 复制 Client ID 和 Client Secret
# 6. 本地运行: node scripts/google-auth.js <CLIENT_ID> <CLIENT_SECRET>
# 7. 浏览器授权后获取 REFRESH_TOKEN
# ===========================================

# OAuth2 Client ID
GOOGLE_CLIENT_ID=

# OAuth2 Client Secret
GOOGLE_CLIENT_SECRET=

# OAuth2 Refresh Token（通过 scripts/google-auth.js 获取）
GOOGLE_REFRESH_TOKEN=

# 根文件夹 ID（可选，留空使用 Drive 根目录）
GOOGLE_ROOT_FOLDER_ID=
