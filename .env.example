# ===========================================
# 个人云网盘 环境变量配置
# ===========================================

# 服务端口
PORT=3000

# 登录密码（请修改为你自己的密码）
AUTH_PASSWORD=changeme123

# JWT 密钥（请修改为随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this

# ===========================================
# Google Drive API 配置（无需信用卡！）
#
# 推荐使用方式 1 (GOOGLE_CREDENTIALS_BASE64)，最可靠
# 方式 2、3 作为备选
# ===========================================

# ---------- 方式 1（推荐）: base64 编码整个 JSON 密钥文件 ----------
# 将下载的 JSON 密钥文件整体 base64 编码后填入
#
# 生成方法（在终端中执行）:
#   Mac/Linux:  base64 -i your-key-file.json
#   Windows:    certutil -encode your-key-file.json encoded.txt
#               然后打开 encoded.txt，去掉头尾的证书标记，把中间的 base64 字符串粘贴到这里
#   或者用 Node: node -e "console.log(require('fs').readFileSync('your-key-file.json').toString('base64'))"
#
# 优点: 完全避免换行符问题，部署平台（Render等）最可靠
GOOGLE_CREDENTIALS_BASE64=

# ---------- 方式 2: 原始 JSON 内容 ----------
# 直接将 JSON 密钥文件的完整内容粘贴到这里
# 注意: 需要是有效的 JSON 字符串
GOOGLE_CREDENTIALS=

# ---------- 方式 3: 分开配置（备选） ----------
# Service Account 邮箱（JSON 密钥文件中的 client_email 字段）
GOOGLE_CLIENT_EMAIL=

# Service Account 私钥（JSON 密钥文件中的 private_key 字段）
# 注意: 保留 -----BEGIN PRIVATE KEY----- 和 -----END PRIVATE KEY-----
# 私钥中的 \n 保持原样即可（代码会自动处理）
GOOGLE_PRIVATE_KEY=

# 根文件夹 ID（可选）
# 留空则使用 Service Account 的 Drive 根目录
GOOGLE_ROOT_FOLDER_ID=
