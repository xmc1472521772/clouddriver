# ===========================================
# 个人云网盘 环境变量配置
# ===========================================

# 服务端口
PORT=3000

# 登录密码（请修改为你自己的密码）
AUTH_PASSWORD=changeme123

# JWT 密钥（请修改为随机字符串）
JWT_SECRET=your-super-secret-jwt-key-change-this

# ===========================================
# Google Drive API 配置（无需信用卡！）
# 获取方式见 README.md
# ===========================================

# Service Account 邮箱（JSON 密钥文件中的 client_email 字段）
# 示例: clouddrive@my-project-123456.iam.gserviceaccount.com
GOOGLE_CLIENT_EMAIL=xmcclouddriver@clouddriver-501605.iam.gserviceaccount.com

# Service Account 私钥（JSON 密钥文件中的 private_key 字段）
# 注意: 需要保留 -----BEGIN PRIVATE KEY----- 和 -----END PRIVATE KEY----- 标记
# 私钥中的 \n 需要保留为字面量（部署时整个值用引号包裹）
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n

# 根文件夹 ID（可选）
# 留空则使用 Service Account 的 Drive 根目录
# 如需指定专用文件夹，填入文件夹 ID（从 Google Drive URL 中获取）
GOOGLE_ROOT_FOLDER_ID=
